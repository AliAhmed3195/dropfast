generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPPLIER
  VENDOR
  VENDOR_USER
  SUPPLIER_USER
  CUSTOMER
}

enum BusinessType {
  VENDOR
  SUPPLIER
}

enum BusinessBusinessType {
  INDIVIDUAL
  COMPANY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  PENDING_VENDOR_APPROVAL
  AWAITING_SUPPLIER_CONFIRMATION
  CONFIRMED
  PACKED
  HANDED_TO_COURIER
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  APPROVAL_REQUIRED
  PROCESSING
  COMPLETED
  CANCELLED
  ON_HOLD
  FAILED
  DISPUTED
  REFUNDED
}

enum PayoutMethod {
  STRIPE_CONNECT
  BANK_TRANSFER
  PAYPAL
  WISE
  CRYPTO
  CHECK
}

enum NotificationType {
  PAYOUT_CREATED
  PAYOUT_APPROVED
  PAYOUT_PROCESSED
  PAYOUT_FAILED
  PAYOUT_COMPLETED
  PAYOUT_CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  password    String
  role        Role
  businessId  String?     // FK to Business (NULL for admin)
  business    Business?   @relation(fields: [businessId], references: [id])
  phone       String?
  dob         DateTime?   // For KYC
  status      UserStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt @default(now())
  
  // Relations
  orders      Order[]
  invoices    Invoice[]
  bankDetails BankDetails?
  stores      Store[]
  supplierProducts Product[] @relation("SupplierProducts")
  supplierPayouts Payout[] @relation("SupplierPayouts")
  vendorPayouts   Payout[] @relation("VendorPayouts")
  payoutNotifications PayoutNotification[]
}

model Business {
  id                  String                @id @default(cuid())
  type                BusinessType
  businessName        String
  businessType        BusinessBusinessType
  registrationNumber  String?
  vatGstNumber        String?
  country             String
  preferredCurrency   String
  addressStreet       String
  addressCity         String
  addressState        String
  addressZip          String
  addressCountry      String
  kycStatus           KycStatus            @default(PENDING)
  stripeAccountId     String?              // Stripe Connected Account ID
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt @default(now())
  
  // Relations
  users               User[]
  stores              Store[]
  products            Product[]
  bankDetails         BankDetails[]
  supplierPayouts     Payout[]             @relation("SupplierPayouts")
  vendorPayouts       Payout[]             @relation("VendorPayouts")
}

model BankDetails {
  id                    String    @id @default(cuid())
  userId                String?   @unique // For individual users
  user                  User?     @relation(fields: [userId], references: [id])
  businessId            String?   // For business accounts
  business              Business? @relation(fields: [businessId], references: [id])
  
  // Country and Stripe Integration
  countryCode           String    // e.g. "US", "UK", "PK", "DE"
  fields                Json      // Dynamic fields based on country
  stripeAccountId       String?   // Stripe Connected Account ID
  kycStatus             KycStatus @default(PENDING)
  
  // Legacy fields (keeping for backward compatibility)
  bankName              String?
  accountHolderName     String?
  accountNumber         String?
  routingNumber         String?
  swiftCode             String?
  iban                  String?
  bankAddress           String?
  bankCity              String?
  bankCountry           String?
  bankPostalCode        String?
  
  // Verification
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?
  verifiedBy            String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt @default(now())
}

model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  template    String   @default("default")
  isActive    Boolean  @default(true)
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  products    Product[]
  orders      Order[]
  invoices    Invoice[]
  storeProducts StoreProduct[]
  // Store branding for invoices
  logo        String?
  banner      String?
  address     String?
  phone       String?
  email       String?
  taxNumber   String?
  invoiceTemplate String @default("default")
  // Multi-currency support
  currency    String   @default("USD")
  // Vendor approval settings
  autoForwardOrders Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?  // Main/primary image (for backward compatibility)
  isActive    Boolean  @default(true)
  featured    Boolean  @default(false) // Featured product flag
  markup      Float    @default(0) // Vendor markup percentage
  supplier    User     @relation("SupplierProducts", fields: [supplierId], references: [id])
  supplierId  String
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  store       Store?   @relation(fields: [storeId], references: [id])
  storeId     String?
  orders      Order[]
  storeProducts StoreProduct[]
  hostedLink  String?  @unique // Generated hosted link for checkout
  variants    Json?    // Store variants as JSON
  // New fields for enhanced product management
  sku         String?  // Stock Keeping Unit
  brandName   String?  // Brand name of the product
  minQuantity Int?     // Minimum quantity for purchasing
  suggestedAmount Float? // Suggested selling price for vendors
  // SEO fields
  metaTitle       String? // Meta title for SEO
  metaDescription String? // Meta description for SEO
  metaTags        String? // Meta tags for SEO (comma-separated)
  // Product categorization - NEW CATALOG SYSTEM
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId String?
  tags        ProductTag[] // Many-to-many relationship with tags
  // Inventory tracking
  totalQuantity   Int @default(0) // Total quantity in stock
  availableQuantity Int @default(0) // Available quantity for sale
  // Shipping information
  shippingInfo Json? // Store shipping information as JSON
  // Product images relationship
  images      ProductImage[]
  // Multi-currency support
  currency    String   @default("USD")
  lockedUSDPrice Float? // Locked USD price at creation
  exchangeRateAtCreation Float? // Exchange rate used at creation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String   // Image URL
  alt       String?  // Alt text for accessibility
  isMain    Boolean  @default(false) // Main/primary image flag
  order     Int      @default(0) // Display order
  createdAt DateTime @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?
  image        String?       // Category image/icon
  isActive     Boolean       @default(true)
  order        Int           @default(0) // Display order
  subcategories Subcategory[]
  products     Product[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt @default(now())
}

model Subcategory {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  image       String?   // Subcategory image/icon
  isActive    Boolean   @default(true)
  order       Int       @default(0) // Display order
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@unique([categoryId, slug])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String?   // Tag color for UI
  isActive  Boolean   @default(true)
  products  ProductTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
}

model ProductTag {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String
  createdAt DateTime @default(now())

  @@unique([productId, tagId])
}

model Order {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  store         Store    @relation(fields: [storeId], references: [id])
  storeId       String
  customer      User?    @relation(fields: [customerId], references: [id])
  customerId    String?
  quantity      Int      @default(1)
  productPrice  Float    // Original supplier price
  markupAmount  Float    // Vendor markup amount
  totalAmount   Float    // Final amount paid by customer
  selectedVariants String? // JSON string of selected variants
  status        OrderStatus @default(PENDING)
  paymentId     String?  // Payment gateway transaction ID
  invoice       Invoice?
  payout        Payout?
  // Multi-currency support
  storeProductId String?
  storeProduct   StoreProduct? @relation(fields: [storeProductId], references: [id])
  lockedUSDPrice Float?
  lockedLocalPrice Float?
  displayPrice  Float?
  displayCurrency String?
  settlementCurrency String @default("USD")
  shippingAddress Json?
  billingAddress Json?
  notes         String?
  // Vendor approval workflow
  requiresVendorApproval Boolean @default(false)
  vendorApprovedAt      DateTime?
  vendorApprovedBy      String?
  vendorRejectedAt      DateTime?
  vendorRejectedBy      String?
  vendorRejectionReason String?
  // Order status history
  statusHistory OrderStatusHistory[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  status      OrderStatus
  reason      String?
  changedBy   String      // User ID who changed the status
  changedAt   DateTime    @default(now())
  notes       String?
  metadata    Json?       // Additional data about the status change
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id])
  storeId       String
  customer      User     @relation(fields: [customerId], references: [id])
  customerId    String
  subtotal      Float
  tax           Float    @default(0)
  total         Float
  status        InvoiceStatus @default(PENDING)
  template      String   @default("default")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StoreProduct {
  id                    String   @id @default(cuid())
  productId             String
  storeId               String
  lockedUSDPrice        Float    // Locked USD price (base for all calculations)
  lockedLocalPrice      Float    // Locked local price in store currency
  localCurrency         String   // Store currency
  exchangeRateAtImport  Float    // Exchange rate at import time
  markup                Float    @default(0) // Vendor markup percentage
  finalPrice            Float    // Final price after markup
  isActive              Boolean  @default(true)
  product               Product  @relation(fields: [productId], references: [id])
  store                 Store    @relation(fields: [storeId], references: [id])
  orders                Order[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([productId, storeId])
  @@map("store_products")
}

model Payout {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  order                 Order    @relation(fields: [orderId], references: [id])
  
  // Parties
  supplierId            String
  supplier              User     @relation("SupplierPayouts", fields: [supplierId], references: [id])
  supplierBusinessId    String?
  supplierBusiness      Business? @relation("SupplierPayouts", fields: [supplierBusinessId], references: [id])
  vendorId              String
  vendor                User     @relation("VendorPayouts", fields: [vendorId], references: [id])
  vendorBusinessId      String?
  vendorBusiness        Business? @relation("VendorPayouts", fields: [vendorBusinessId], references: [id])
  
  // Financial Breakdown (in USD - base currency)
  orderTotal            Float    // Original order total
  supplierAmount        Float    // Supplier's share (no platform fee)
  vendorGrossAmount     Float    // Vendor's gross amount
  platformFee           Float    // Platform fee (5% of vendor amount)
  transactionFee        Float    // Payment processing fee
  currencyConversionFee Float    @default(0) // Multi-currency conversion fee
  
  // Final Amounts (in USD)
  finalSupplierAmount   Float    // What supplier actually receives
  finalVendorAmount     Float    // What vendor actually receives
  platformRevenue       Float    // Platform's total revenue
  
  // Currency Information
  baseCurrency          String   @default("USD")
  supplierCurrency      String   // Supplier's preferred currency
  vendorCurrency        String   // Vendor's preferred currency
  exchangeRateAtPayout  Float?   // Exchange rate used for conversion
  
  // Payout Locking
  isLocked              Boolean  @default(false) // Whether payout amounts are locked
  lockedAt              DateTime? // When amounts were locked
  lockedExchangeRate    Float?   // Exchange rate at locking time
  lockedSupplierAmount  Float?   // Locked supplier amount in supplier currency
  lockedVendorAmount    Float?   // Locked vendor amount in vendor currency
  
  // Payout Details
  status                PayoutStatus @default(PENDING)
  payoutMethod          PayoutMethod @default(STRIPE_CONNECT)
  payoutDate            DateTime?
  processedAt           DateTime?
  
  // External References
  stripeTransferId      String?
  stripePayoutId        String?
  bankReference         String?
  wiseTransferId        String?
  
  // Approval Workflow
  requiresApproval      Boolean  @default(false)
  approvedBy            String?
  approvedAt            DateTime?
  approvalNotes         String?
  
  // Tracking
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  statusHistory         PayoutStatusHistory[]
  notifications         PayoutNotification[]
}

model PayoutStatusHistory {
  id          String   @id @default(cuid())
  payoutId    String
  payout      Payout   @relation(fields: [payoutId], references: [id])
  status      PayoutStatus
  reason      String?
  changedBy   String
  changedAt   DateTime @default(now())
  notes       String?
}

model PayoutNotification {
  id        String   @id @default(cuid())
  payoutId  String
  payout    Payout   @relation(fields: [payoutId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}