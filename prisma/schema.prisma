generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  isActive  Boolean  @default(true)
  stores    Store[]
  products  Product[] @relation("SupplierProducts")
  orders    Order[]
  invoices  Invoice[]
  createdAt DateTime @default(now())
}

model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  template    String   @default("default")
  isActive    Boolean  @default(true)
  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String
  products    Product[]
  orders      Order[]
  invoices    Invoice[]
  // Store branding for invoices
  logo        String?
  banner      String?
  address     String?
  phone       String?
  email       String?
  taxNumber   String?
  invoiceTemplate String @default("default")
  createdAt   DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?  // Main/primary image (for backward compatibility)
  category    String?
  isActive    Boolean  @default(true)
  featured    Boolean  @default(false) // Featured product flag
  markup      Float    @default(0) // Vendor markup percentage
  supplier    User     @relation("SupplierProducts", fields: [supplierId], references: [id])
  supplierId  String
  store       Store?   @relation(fields: [storeId], references: [id])
  storeId     String?
  orders      Order[]
  hostedLink  String?  @unique // Generated hosted link for checkout
  variants    Json?    // Store variants as JSON
  // New fields for enhanced product management
  sku         String?  // Stock Keeping Unit
  brandName   String?  // Brand name of the product
  minQuantity Int?     // Minimum quantity for purchasing
  suggestedAmount Float? // Suggested selling price for vendors
  // SEO fields
  metaTitle       String? // Meta title for SEO
  metaDescription String? // Meta description for SEO
  metaTags        String? // Meta tags for SEO (comma-separated)
  // Product categorization
  type        String?  // Product type (e.g., Electronics, Clothing)
  subCategory String?  // Sub category (e.g., Smartphones, T-Shirts)
  // Inventory tracking
  totalQuantity   Int @default(0) // Total quantity in stock
  availableQuantity Int @default(0) // Available quantity for sale
  // Shipping information
  shippingInfo Json? // Store shipping information as JSON
  // Product images relationship
  images      ProductImage[]
  createdAt   DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String   // Image URL
  alt       String?  // Alt text for accessibility
  isMain    Boolean  @default(false) // Main/primary image flag
  order     Int      @default(0) // Display order
  createdAt DateTime @default(now())
}


model Order {
  id            String   @id @default(cuid())
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  store         Store    @relation(fields: [storeId], references: [id])
  storeId       String
  customer      User     @relation(fields: [customerId], references: [id])
  customerId    String
  quantity      Int      @default(1)
  productPrice  Float    // Original supplier price
  markupAmount  Float    // Vendor markup amount
  totalAmount   Float    // Final amount paid by customer
  selectedVariants String? // JSON string of selected variants
  status        OrderStatus @default(PENDING)
  paymentId     String?  // Payment gateway transaction ID
  invoice       Invoice?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id])
  storeId       String
  customer      User     @relation(fields: [customerId], references: [id])
  customerId    String
  subtotal      Float
  tax           Float    @default(0)
  total         Float
  status        InvoiceStatus @default(PENDING)
  template      String   @default("default")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Role {
  ADMIN
  SUPPLIER
  VENDOR
}